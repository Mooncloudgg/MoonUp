{
  "productName": "Moonup",
  "version": "2.1.2",
  "identifier": "com.mooncloud.moonup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Moonup",
        "width": 430,
        "height": 720,
        "resizable": false,
        "fullscreen": false,
        "maximizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://raw.githubusercontent.com https://media.forgecdn.net; connect-src 'self' https://mooncloud.team https://api.github.com https://github.com https://api.curseforge.com https://api.curse.tools https://edge.forgecdn.net;",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Mooncloud",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MDVFQTY5MTA2QzQxOTYKUldTV1FXd1FhZW9GMWdXRC9WZkRjOHM3YkJVa2g3VjkxSjhXK2tzaUhHYTZBM25oY2w4bDJteHAK",
      "endpoints": [
        "https://github.com/Mooncloudgg/MoonUp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installerArgs": ["/S"]
      }
    }
  }
}